# ==============================================================================
# BuildFolio Environment Configuration Template
# Copy this file to `.env` before running locally or with Docker Compose:
#   cp .env.example .env (Linux/macOS)
#   Copy-Item .env.example .env (Windows PowerShell)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_DB=buildfolio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433
DB_PASSWORD=postgres

# ------------------------------------------------------------------------------
# 2. AI & SEMANTIC SEARCH (Spring AI + Ollama Local LLM)
# Local inference & embeddings via Ollama (zero API key cost)
# Run locally: ollama run llama3 && ollama pull nomic-embed-text
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- OpenAI Configuration (Commented out) ---
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_CHAT_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 3. GITHUB OAUTH APPLICATION CREDENTIALS
# Create at: https://github.com/settings/developers -> "OAuth Apps" -> "New OAuth App"
# - Application name: BuildFolio (Local)
# - Homepage URL: http://localhost:3000
# - Authorization callback URL: http://localhost:8080/login/oauth2/code/github
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ------------------------------------------------------------------------------
# 4. TOKEN ENCRYPTION (AES-256)
# Used to securely encrypt GitHub access tokens at rest in the database.
# Note: Salt must be a valid hex string with an even number of digits (e.g. 16 hex chars).
# ------------------------------------------------------------------------------
TOKEN_ENCRYPTOR_PASSWORD=buildfolioSecretPass123
TOKEN_ENCRYPTOR_SALT=7a9e3b4c1d2e5f80

# ------------------------------------------------------------------------------
# 5. GITHUB WEBHOOKS & SECURITY (Optional HMAC-SHA256 signature)
# Optional secret used to verify incoming push webhooks from GitHub.
# ------------------------------------------------------------------------------
WEBHOOK_SECRET=your-optional-webhook-secret-here

# ------------------------------------------------------------------------------
# 6. APPLICATION URLS
# ------------------------------------------------------------------------------
APP_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
